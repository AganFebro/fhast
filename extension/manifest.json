{
  "manifest_version": 3,
  "name": "fhast Link Grabber",
  "version": "0.1.0",
  "description": "Send download links from Chrome to fhast download manager",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "storage"],
  "optional_permissions": ["downloads", "webRequest", "cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "fhast",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
